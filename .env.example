# === Public keys (safe for browser) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Secret keys (server only, NEVER add NEXT_PUBLIC_ prefix) ===
SUPABASE_SERVICE_ROLE_KEY=

# Whisper 轉錄:Groq(免費 6000 次/天)
GROQ_API_KEY=

# 亮點選段 + 校字:Google Gemini
# ⚠️ 免費層 RPD/RPM/TPM 是動態的,實際配額看 https://aistudio.google.com/rate-limit
# 預設用 gemini-3.5-flash-lite(GA、high-volume、免費層寬)
# 舊版 gemini-2.5-flash-lite 部分 API region 已回 404,不再建議
# 想試更新版可改 gemini-3.6-flash / gemini-3.7-flash(但 RPM 通常更緊)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# === Feature flags ===
# 是否顯示 Google 登入按鈕(需先在 Supabase Auth Providers 開啟 Google)
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# 字幕字型檔案 URL(必須是 OTF/TTF,drawtext filter 需要)
# 預設用 Noto Sans TC(繁中,~4MB)
NEXT_PUBLIC_SUBTITLE_FONT_URL=https://cdn.jsdelivr.net/gh/notofonts/noto-cjk@main/Sans/SubsetOTF/TC/NotoSansTC-Regular.otf

# === Rate limits (adjust as needed) ===
RATE_LIMIT_PER_IP_PER_HOUR=20
FREE_DAILY_QUOTA=1
FREE_SIGNUP_BONUS=5

# === 無限帳號(逗號分隔的 email,只在後端讀取,仍受速率限制)===
UNLIMITED_EMAILS=
